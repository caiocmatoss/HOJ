# Desenvolvimento web no mesmo computador: use localhost.
# EXPO_PUBLIC_BACKEND_URL=http://localhost:3000

# Dispositivo físico: use o IP LAN do computador onde o backend está rodando.
# EXPO_PUBLIC_BACKEND_URL=http://IP-LAN-DO-COMPUTADOR:3000

# Produção: use a URL pública HTTPS real do backend.
# EXPO_PUBLIC_BACKEND_URL=https://SEU-BACKEND-PUBLICO

EXPO_PUBLIC_BACKEND_URL=http://localhost:3000