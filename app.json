{
  "expo": {
    "name": "HOJE É ONDE",
    "slug": "HojeEOnd",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/brand-icon.png",
    "scheme": "hojeeond",
    "userInterfaceStyle": "dark",
    "ios": {
      "icon": "./assets/images/brand-icon.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0B0D0F",
        "foregroundImage": "./assets/images/brand-android-foreground.png",
        "monochromeImage": "./assets/images/brand-android-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/brand-favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B0D0F",
          "image": "./assets/images/brand-splash.png",
          "imageWidth": 116,
          "resizeMode": "contain"
        }
      ],
      "expo-image",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
